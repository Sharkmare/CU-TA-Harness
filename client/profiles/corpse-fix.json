{
  "name": "corpse-fix",
  "topic": "CORPSE",
  "sources": [
    ".state/corpse_run*/*.json",
    ".state/corpse_dune/*.json",
    ".state/corpse_milky/*.json",
    ".state/corpse_fix*/*.json",
    ".state/corpse_tip*/*.json",
    ".state/tiphits2_reports/*.json",
    ".state/plainhits_reports/*.json",
    ".state/tipcrates2_reports/*.json",
    ".state/plaincrates2_reports/*.json",
    ".state/tipmining_reports/*.json",
    ".state/plainmining_reports/*.json"
  ],
  "params": {
    "real_rate_median_max": 0.3
  },
  "superseded_confounders": [
    "^host hold at"
  ],
  "header": [
    {
      "id": "game_version"
    },
    {
      "id": "swings",
      "text": "{n} bare swings"
    },
    {
      "id": "median_interval"
    },
    {
      "id": "distance",
      "text": "corpse"
    },
    {
      "id": "held"
    }
  ],
  "builds": {
    "pr24-corpse-verbose": {
      "stageDll": "../Private CU together/build/stage_pr24_corpse_verbose/plugins/Together/CasualtiesMP.dll"
    },
    "pr24-corpse-fix": {
      "stageDll": "../Private CU together/build/stage_pr24_corpse_fix/plugins/Together/CasualtiesMP.dll"
    },
    "pr24-3d060fe-corpse-fix": {
      "stageDll": "../Private CU together/build/stage_pr24_3d060fe_corpse_fix/plugins/Together/CasualtiesMP.dll"
    },
    "pr24-3d060fe-plain": {
      "stageDll": "../Private CU together/build/stage_pr24_3d060fe_plain/plugins/Together/CasualtiesMP.dll"
    }
  },
  "tables": [
