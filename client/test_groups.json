{
  "shared": [
    "casualtieslink/*.py",
    "tests/rig.py",
    "tests/__init__.py",
    "../plugin/*.cs",
    "../plugin/*.csproj",
    "test_groups.json"
  ],
  "groups": [
    {
      "id": "inert",
      "watch": [
        "tests/test_inert.py"
      ],
      "modules": [
        "tests.test_inert"
      ],
      "needs_game": false,
      "owns_game": true
    },
    {
      "id": "pair",
      "watch": [
        "tests/test_pair.py",
        "tests/test_pair_visuals.py"
      ],
      "modules": [
        "tests.test_pair",
        "tests.test_pair_visuals"
      ],
      "needs_game": false,
      "owns_game": true
    },
    {
      "id": "link",
      "watch": [
        "tests/test_link.py"
      ],
      "modules": [
        "tests.test_link"
      ],
      "needs_game": true
    },
    {
      "id": "run",
      "watch": [
        "tests/test_run.py"
      ],
      "modules": [
        "tests.test_run"
      ],
      "needs_game": true
    },
    {
      "id": "world",
      "watch": [
        "tests/test_world.py"
      ],
      "modules": [
        "tests.test_world"
      ],
      "needs_game": true
    },
    {
      "id": "client-offline",
      "watch": [
        "unit/*.py",
        "run_tests.py",
        "selection.py"
      ],
      "modules": [
        "unit.test_parsing",
        "unit.test_selection",
        "unit.test_lock",
        "unit.test_testcopy"
      ],
      "needs_game": false
    },
    {
      "id": "repo-tools",
      "watch": [
        "../tools/*.py"
      ],
      "modules": [
        "tools.test_check_commit_message"
      ],
      "needs_game": false
    }
  ]
}